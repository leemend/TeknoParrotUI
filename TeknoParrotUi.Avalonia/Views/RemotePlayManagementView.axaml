<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TeknoParrotUi.Avalonia.Views.RemotePlayManagementView">
  <ScrollViewer>
    <StackPanel Margin="14"
                Spacing="14"
                HorizontalAlignment="Stretch">

      <StackPanel Spacing="4">
        <TextBlock Text="Remote Play"
                   FontSize="20"
                   FontWeight="Bold"/>
        <TextBlock Text="Host games with Sunshine or connect to another TeknoParrot host with Moonlight."
                   Opacity="0.7"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Sunshine host -->
      <Border BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <StackPanel Spacing="12">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="Sunshine Host"
                         FontSize="19"
                         FontWeight="SemiBold"/>
              <TextBlock Name="SunshineStatusDetail"
                         TextWrapping="Wrap"
                         Opacity="0.75"/>
            </StackPanel>

            <Border Grid.Column="1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4"
                    VerticalAlignment="Top">
              <TextBlock Name="SunshineStatusText"
                         Text="Checking..."
                         FontWeight="SemiBold"/>
            </Border>
          </Grid>

          <TextBlock Name="ManagedApiDetailText"
                     Text="Managed API disconnected"
                     TextWrapping="Wrap"
                     Opacity="0.7"/>

          <StackPanel Orientation="Horizontal"
                      Spacing="6">
            <Button Name="BtnStartSunshine"
                    Content="Start"
                    Click="BtnStartSunshine_Click"/>
            <Button Name="BtnStopSunshine"
                    Content="Stop"
                    Click="BtnStopSunshine_Click"/>
            <Button Name="BtnRestartSunshine"
                    Content="Restart"
                    Click="BtnRestartSunshine_Click"/>
            <Button Name="BtnOpenSunshineWebUi"
                    Content="Open Web UI"
                    Click="BtnOpenSunshineWebUi_Click"/>
          </StackPanel>

          <!-- Host connection -->
          <Border BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Host Connection"
                         FontSize="17"
                         FontWeight="SemiBold"/>

              <StackPanel Orientation="Horizontal"
                          Spacing="12">
                <RadioButton Name="RadioConnectionOpen"
                             GroupName="ConnectionMode"
                             Content="Open"
                             IsCheckedChanged="ConnectionMode_Checked"/>
                <RadioButton Name="RadioConnectionClosed"
                             GroupName="ConnectionMode"
                             Content="Closed"
                             IsCheckedChanged="ConnectionMode_Checked"/>
              </StackPanel>

              <Grid ColumnDefinitions="160,*"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="4">
                <TextBlock Text="Connection state"/>
                <TextBlock Name="ConnectionStateText"
                           Grid.Column="1"
                           Text="—"/>

                <TextBlock Grid.Row="1"
                           Text="Active streams"/>
                <TextBlock Name="ActiveSessionsText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="—"/>

                <TextBlock Grid.Row="2"
                           Text="Paired clients"/>
                <TextBlock Name="PairedClientsText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Text="—"/>
              </Grid>

              <TextBlock Name="ConnectionModeDetailText"
                         Text="Waiting for Sunshine..."
                         TextWrapping="Wrap"
                         Opacity="0.7"/>
            </StackPanel>
          </Border>

          <!-- Pairing -->
          <Border BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Pairing"
                         FontSize="17"
                         FontWeight="SemiBold"/>

              <TextBlock Name="PairingStatusText"
                         Text="Waiting on pairing requests"
                         TextWrapping="Wrap"
                         Opacity="0.75"/>

              <Grid ColumnDefinitions="150,*"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="6">
                <TextBlock Text="Pairing PIN"
                           VerticalAlignment="Center"/>
                <TextBox Name="PairingPinTextBox"
                         Grid.Column="1"
                         MaxLength="4"
                         PlaceholderText="0000"/>

                <TextBlock Grid.Row="1"
                           Text="Connection name"
                           VerticalAlignment="Center"/>
                <TextBox Name="PairingNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         PlaceholderText="Optional"/>
              </Grid>

              <Button Name="BtnPairClient"
                      Content="Pair Client"
                      HorizontalAlignment="Left"
                      Click="BtnPairClient_Click"/>
            </StackPanel>
          </Border>

          <!-- Connected / paired clients -->
          <Border BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Moonlight Clients"
                         FontSize="17"
                         FontWeight="SemiBold"/>

              <TextBlock Name="ClientListStatusText"
                         Text="Waiting for Sunshine..."
                         TextWrapping="Wrap"
                         Opacity="0.75"/>

              <ListBox Name="ClientsListBox"
                       MinHeight="100"
                       MaxHeight="220"
                       SelectionChanged="ClientsListBox_SelectionChanged"/>

              <StackPanel Orientation="Horizontal"
                          Spacing="6">
                <Button Name="BtnRefreshClients"
                        Content="Refresh"
                        Click="BtnRefreshClients_Click"/>

                <Button Name="BtnEditClientProfile"
                        Content="Edit Profile"
                        Click="BtnEditClientProfile_Click"/>

                <Button Name="BtnMapClientControls"
                        Content="Map Controls"
                        Click="BtnMapClientControls_Click"/>

                <Button Name="BtnDisconnectAll"
                        Content="Disconnect All"
                        Click="BtnDisconnectAll_Click"/>

                <Button Name="BtnUnpairClient"
                        Content="Unpair Selected"
                        Click="BtnUnpairClient_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Moonlight client -->
      <Border BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <StackPanel Spacing="12">

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="Moonlight Client"
                         FontSize="19"
                         FontWeight="SemiBold"/>
              <TextBlock Name="MoonlightStatusDetailText"
                         TextWrapping="Wrap"
                         Opacity="0.75"/>
            </StackPanel>

            <Border Grid.Column="1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,4"
                    VerticalAlignment="Top">
              <TextBlock Name="MoonlightInstallStatusText"
                         Text="Checking..."
                         FontWeight="SemiBold"/>
            </Border>
          </Grid>

          <TextBlock Name="MoonlightPathText"
                     TextWrapping="Wrap"
                     FontFamily="monospace"
                     FontSize="11"
                     Opacity="0.7"/>

          <StackPanel Orientation="Horizontal"
                      Spacing="6">
            <Button Name="BtnStartMoonlight"
                    Content="Enable Client"
                    Click="BtnStartMoonlight_Click"/>
            <Button Name="BtnStopMoonlight"
                    Content="Stop"
                    Click="BtnStopMoonlight_Click"/>
            <Button Name="BtnOpenMoonlight"
                    Content="Open Moonlight"
                    Click="BtnOpenMoonlight_Click"/>
          </StackPanel>

          <!-- Target host -->
          <Border BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Host Connection"
                         FontSize="17"
                         FontWeight="SemiBold"/>

              <Grid ColumnDefinitions="150,*">
                <TextBlock Text="Host address"
                           VerticalAlignment="Center"/>
                <TextBox Name="MoonlightHostTextBox"
                         Grid.Column="1"
                         PlaceholderText="IP address or hostname"
                         TextChanged="MoonlightHostTextBox_TextChanged"/>
              </Grid>

              <TextBlock Name="MoonlightConnectionStatusText"
                         Text="Enter a host address to begin."
                         TextWrapping="Wrap"
                         Opacity="0.75"/>
            </StackPanel>
          </Border>

          <!-- Client-side pairing -->
          <Border BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Pairing"
                         FontSize="17"
                         FontWeight="SemiBold"/>

              <Grid ColumnDefinitions="150,*">
                <TextBlock Text="Pairing PIN"
                           VerticalAlignment="Center"/>
                <TextBlock Name="MoonlightGeneratedPinText"
                           Grid.Column="1"
                           Text="----"
                           FontSize="24"
                           FontWeight="Bold"/>
              </Grid>

              <TextBlock Name="MoonlightPairStatusText"
                         Text="Generate a PIN, then enter it on the Sunshine host."
                         TextWrapping="Wrap"
                         Opacity="0.75"/>

              <Button Name="BtnMoonlightPair"
                      Content="Generate PIN &amp; Pair"
                      HorizontalAlignment="Left"
                      Click="BtnMoonlightPair_Click"/>
            </StackPanel>
          </Border>

          <!-- Host applications -->
          <Border BorderThickness="1"
                  CornerRadius="6"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Host Applications"
                         FontSize="17"
                         FontWeight="SemiBold"/>

              <ListBox Name="MoonlightAppsListBox"
                       MinHeight="110"
                       MaxHeight="220"
                       SelectionChanged="MoonlightAppsListBox_SelectionChanged"/>

              <StackPanel Orientation="Horizontal"
                          Spacing="6">
                <Button Name="BtnMoonlightRefreshApps"
                        Content="Refresh Apps"
                        Click="BtnMoonlightRefreshApps_Click"/>

                <Button Name="BtnMoonlightStartStream"
                        Content="Access Stream"
                        Click="BtnMoonlightStartStream_Click"/>

                <Button Name="BtnMoonlightQuitStream"
                        Content="Quit Stream"
                        Click="BtnMoonlightQuitStream_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
